---
/** FAQ con <details> nativo: accesible y sin JS. */
interface Props {
  items: { q: string; a: string }[];
  headingLevel?: 'h3' | 'h4';
}
const { items, headingLevel: H = 'h3' } = Astro.props;
---

<div class="faq space-y-3">
  {
    items.map((it, i) => (
      <details class="faq__item rounded-[24px] border-2 border-ink bg-cream" open={i === 0}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 md:p-6">
          <H class="font-sans text-lg font-bold normal-case leading-snug tracking-normal md:text-xl">{it.q}</H>
          <span class="faq__icon grid size-9 shrink-0 place-items-center rounded-full border-2 border-ink bg-lemon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M12 5v14M5 12h14"></path></svg>
          </span>
        </summary>
        <div class="px-5 pb-6 md:px-6">
          <p class="max-w-prose text-ink-soft">{it.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__icon {
    transition: transform 0.25s ease;
  }
  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    background: var(--coral);
  }
  .faq__item h3,
  .faq__item h4 {
    text-transform: none;
    font-family: var(--font-sans);
  }
</style>
