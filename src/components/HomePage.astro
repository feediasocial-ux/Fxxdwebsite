---
/**
 * Home focalizzata (7 blocchi essenziali):
 * 1. Hero + Marquee · 2. Antes / Después del Feed · 3. Cómo funciona (3 pasos) ·
 * 4. Casos reales (4 muestras) · 5. Paquetes + Plan B compacto ·
 * 6. Sectores (enlaces limpios) + Quiénes somos · 7. FAQ esenciales (5) + CTA final
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Marquee from '@/components/Marquee.astro';
import Button from '@/components/Button.astro';
import StepCard from '@/components/StepCard.astro';
import PackageCard from '@/components/PackageCard.astro';
import FAQ from '@/components/FAQ.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import BookCallButton from '@/components/BookCallButton.astro';
import FeedBeforeAfter from '@/components/FeedBeforeAfter.astro';
import Photo from '@/components/Photo.astro';
import { getUi } from '@/content';
import { getNichesByCountry } from '@/content/niches';
import { PACKAGES } from '@/content/pricing';
import { COUNTRIES, type CountryKey } from '@/lib/i18n';
import { linkTo } from '@/lib/routes';
import { faqPageJsonLd, serviceJsonLd } from '@/lib/seo';
import type { ImageMetadata } from 'astro';

import fundadoraDaniela from '@/assets/photos/feediasocial-fundadora-daniela.webp';
import casoCopimax from '@/assets/photos/feediasocial-caso-copimax.webp';
import casoDolorfin from '@/assets/photos/feediasocial-caso-dolorfin-clinica.webp';
import casoMudra from '@/assets/photos/feediasocial-caso-mudra-pilates.webp';
import casoCedres from '@/assets/photos/feediasocial-caso-cedres-musica.webp';

interface Props {
  country: CountryKey;
  heroImage: ImageMetadata;
}

const { country, heroImage } = Astro.props;
const ui = getUi(country);
const niches = getNichesByCountry(country);
const path = COUNTRIES[country].basePath;
const homeFaqs = ui.faqSection.items.slice(0, 5);
---

<BaseLayout
  pageId="home"
  jsonLdNodes={[
    ...serviceJsonLd({
      name: ui.meta.homeTitle,
      description: ui.meta.homeDescription,
      path,
      country,
      serviceType: 'Social Media Content Agency',
    }),
    faqPageJsonLd(homeFaqs),
  ]}
  seo={{
    title: ui.meta.homeTitle,
    description: ui.meta.homeDescription,
    path,
    routeKey: 'home',
    country,
    xDefault: true,
  }}
>
  <!-- 1. Hero + Marquee -->
  <Hero
    copy={ui.hero}
    country={country}
    page="home"
    waMessage={ui.whatsapp.defaultMessage}
    waA11y={ui.a11y.openWhatsApp}
    secondaryHref="#paquetes"
    image={heroImage}
  />

  <Marquee items={ui.marquee} label={ui.a11y.marqueePaused} tone="ink" />

  <!-- 2. Problema → Solución: Comparador visual Antes / Después del Feed -->
  <FeedBeforeAfter country={country} />

  <!-- 3. Cómo funciona (3 pasos limpios) -->
  <section class="theme-dark py-16 md:py-24">
    <div class="container-site">
      <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
        <div class="max-w-3xl space-y-4">
          <p class="inline-block rounded-pill border-2 border-cream bg-maroon px-4 py-1 text-sm font-bold uppercase text-lemon">
            {ui.stepsSection.eyebrow}
          </p>
          <h2 class="text-display-lg text-cream">{ui.stepsSection.title}</h2>
          <p class="text-lg text-cream/85">{ui.stepsSection.subtitle}</p>
        </div>
        <Button href={linkTo('comoFunciona', country)} variant="lemon" size="md">
          {ui.stepsSection.ctaMore}
        </Button>
      </div>

      <ol class="mt-10 grid gap-6 md:grid-cols-3">
        {
          ui.steps.map((s, i) => (
            <StepCard
              n={i + 1}
              title={s.title}
              text={s.text}
              color={i === 0 ? 'lemon' : i === 1 ? 'coral' : 'sky'}
            />
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 4. Casos reales (4 muestras concretas + enlace a Casos y guiones) -->
  <section class="container-site py-16 md:py-24">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-3xl space-y-4">
        <p class="inline-block rounded-pill border-2 border-ink bg-coral px-4 py-1 text-sm font-bold uppercase">
          {ui.proofSection.eyebrow}
        </p>
        <h2 class="text-display-lg">{ui.proofSection.title}</h2>
        <p class="text-lg text-ink-soft">{ui.proofSection.subtitle}</p>
      </div>
      <Button href={linkTo('comoTrabajamos', country)} variant="outline">
        {ui.proofSection.ctaMore}
      </Button>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-4">
      <div class="overflow-hidden rounded-[24px] border-2 border-ink bg-cream-deep p-3 shadow-[4px_4px_0_0_var(--ink)]">
        <div class="overflow-hidden rounded-2xl border border-ink">
          <Photo src={casoCopimax} alt="Perfil de Instagram de Copimax con reels de 1,2 M y 12,4 M de reproducciones" aspect="9/16" widths={[280, 420]} sizes="(min-width: 1024px) 22vw, 45vw" />
        </div>
        <p class="mt-2.5 text-xs font-bold text-ink">Copimax · Reels orgánicos con guion</p>
      </div>
      <div class="overflow-hidden rounded-[24px] border-2 border-ink bg-cream-deep p-3 shadow-[4px_4px_0_0_var(--ink)]">
        <div class="overflow-hidden rounded-2xl border border-ink">
          <Photo src={casoDolorfin} alt="Perfil de Instagram de clínicas Dolorfin Quiroprácticos (22 sucursales)" aspect="9/16" widths={[280, 420]} sizes="(min-width: 1024px) 22vw, 45vw" />
        </div>
        <p class="mt-2.5 text-xs font-bold text-ink">Clínicas Dolorfin · Divulgación sanitaria</p>
      </div>
      <div class="overflow-hidden rounded-[24px] border-2 border-ink bg-cream-deep p-3 shadow-[4px_4px_0_0_var(--ink)]">
        <div class="overflow-hidden rounded-2xl border border-ink">
          <Photo src={casoMudra} alt="Perfil de Instagram de estudio Mudra Pilates Reformer" aspect="9/16" widths={[280, 420]} sizes="(min-width: 1024px) 22vw, 45vw" />
        </div>
        <p class="mt-2.5 text-xs font-bold text-ink">Mudra Pilates · Estética editorial y reservas</p>
      </div>
      <div class="overflow-hidden rounded-[24px] border-2 border-ink bg-cream-deep p-3 shadow-[4px_4px_0_0_var(--ink)]">
        <div class="overflow-hidden rounded-2xl border border-ink">
          <Photo src={casoCedres} alt="Perfil de Instagram de Cedres con serie de Reels y 19,1 mil seguidores" aspect="9/16" widths={[280, 420]} sizes="(min-width: 1024px) 22vw, 45vw" />
        </div>
        <p class="mt-2.5 text-xs font-bold text-ink">Cedres · Serie de Reels con identidad</p>
      </div>
    </div>
  </section>

  <!-- 5. Paquetes con precio del país + Plan B compacto -->
  <section id="paquetes" class="container-site py-16 md:py-24">
    <div class="max-w-3xl space-y-4">
      <p class="inline-block rounded-pill border-2 border-ink bg-lemon px-4 py-1 text-sm font-bold uppercase">
        {ui.pricing.eyebrow}
      </p>
      <h2 class="text-display-lg">{ui.pricing.title}</h2>
      <p class="text-lg text-ink-soft">{ui.pricing.subtitle}</p>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-3">
      {PACKAGES.map((pkg) => <PackageCard pkg={pkg} country={country} page="home" />)}
    </div>

    <div class="mt-8 space-y-1 text-sm text-ink-soft">
      <p>• {ui.pricing.adsNote}</p>
      <p>• {ui.pricing.taxNote}</p>
    </div>

    <!-- Plan B sin cámara compacto -->
    <div class="mt-10 flex flex-col items-start justify-between gap-5 rounded-[28px] border-2 border-ink bg-sky p-6 shadow-[6px_6px_0_0_var(--ink)] md:flex-row md:items-center md:p-8">
      <div class="max-w-2xl space-y-1.5">
        <h3 class="text-2xl md:text-3xl">{ui.pricing.planBTitle}</h3>
        <p class="text-sm text-ink-soft md:text-base">{ui.pricing.planBText}</p>
      </div>
      <Button href={linkTo('intencionSinCamara', country)} variant="dark" size="md" class="shrink-0">
        {ui.pricing.planBGuideCta}
      </Button>
    </div>
  </section>

  <!-- 6. Sectores (enlaces compactos) + Quiénes somos -->
  <section class="container-site pb-16 md:pb-20">
    <div class="max-w-3xl space-y-3">
      <p class="inline-block rounded-pill border-2 border-ink bg-cream-deep px-4 py-1 text-sm font-bold uppercase">
        {ui.nichesSection.eyebrow}
      </p>
      <h2 class="text-display-md">{ui.nichesSection.title}</h2>
    </div>

    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        niches.map((niche) => (
          <a
            href={linkTo(niche.routeKey, country)}
            class="group flex items-center justify-between gap-3 rounded-2xl border-2 border-ink bg-cream-deep px-5 py-4 text-ink no-underline shadow-[4px_4px_0_0_var(--ink)] transition-transform hover:-translate-y-0.5 hover:bg-lemon"
          >
            <span class="font-display text-lg uppercase">{niche.shortTitle}</span>
            <span class="text-sm font-extrabold text-coral-deep transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="theme-dark py-16 md:py-24">
    <div class="container-site grid items-center gap-10 lg:grid-cols-[1.2fr_0.8fr]">
      <div class="space-y-5">
        <p class="inline-block rounded-pill border-2 border-cream bg-maroon px-4 py-1 text-sm font-bold uppercase text-lemon">
          {ui.aboutTeaser.eyebrow}
        </p>
        <h2 class="text-display-lg text-cream">{ui.aboutTeaser.title}</h2>
        <p class="text-lg text-cream/85">{ui.aboutTeaser.text}</p>
        <ul class="space-y-2.5 text-cream/90">
          {
            ui.aboutTeaser.bullets.map((b) => (
              <li class="flex gap-2.5">
                <span class="font-bold text-lemon" aria-hidden="true">✓</span>
                <span>{b}</span>
              </li>
            ))
          }
        </ul>
        <div class="pt-2">
          <Button href={linkTo('sobreNosotros', country)} variant="lemon" size="lg">
            {ui.aboutTeaser.cta}
          </Button>
        </div>
      </div>

      <div class="mx-auto w-full max-w-sm overflow-hidden rounded-[28px] border-2 border-cream shadow-[8px_8px_0_0_var(--coral)]">
        <Photo src={fundadoraDaniela} alt={ui.aboutTeaser.founder1Placeholder} aspect="3/4" widths={[360, 540]} sizes="(min-width: 1024px) 28vw, 85vw" />
      </div>
    </div>
  </section>

  <!-- 7. FAQ esenciales (5) + CTA final limpio -->
  <section class="container-site py-16 md:py-24">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr]">
      <div class="space-y-4">
        <p class="inline-block rounded-pill border-2 border-ink bg-coral px-4 py-1 text-sm font-bold uppercase">
          {ui.faqSection.eyebrow}
        </p>
        <h2 class="text-display-lg">{ui.faqSection.title}</h2>
      </div>
      <FAQ items={homeFaqs} />
    </div>
  </section>

  <section id="mini-auditoria" class="container-site pb-20">
    <div class="flex flex-col items-start justify-between gap-8 rounded-[36px] border-2 border-ink bg-maroon p-8 text-cream shadow-[10px_10px_0_0_var(--ink)] lg:flex-row lg:items-center md:p-12">
      <div class="max-w-2xl space-y-4">
        <h2 class="text-display-md text-cream">{ui.finalCta.title}</h2>
        <p class="text-lg text-cream/85">{ui.finalCta.subtitle}</p>
      </div>
      <div class="flex flex-wrap gap-3 shrink-0">
        <WhatsAppButton
          message={ui.finalCta.waMessage}
          label={ui.finalCta.cta}
          a11yLabel={ui.a11y.openWhatsApp}
          country={country}
          page="home"
          placement="final-cta"
          variant="lemon"
          size="lg"
        />
        <BookCallButton
          country={country}
          page="home"
          placement="final-cta"
          variant="light"
          size="lg"
        />
      </div>
    </div>
  </section>
</BaseLayout>
