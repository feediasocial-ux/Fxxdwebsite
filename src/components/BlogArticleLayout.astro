---
/**
 * Plantilla editorial escaneable en 20 segundos:
 * Resumen clave arriba, takeaways + bullets + recursos visuales visibles al instante,
 * y párrafos de desarrollo profundo en <details> nativo (0 KB JS, 100 % indexable por Google).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Photo from '@/components/Photo.astro';
import FAQ from '@/components/FAQ.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import BookCallButton from '@/components/BookCallButton.astro';
import CarouselPreviewMockup from '@/components/CarouselPreviewMockup.astro';
import RecordingTimeline30m from '@/components/RecordingTimeline30m.astro';
import { getUi } from '@/content';
import type { EditorialBlogArticle } from '@/content/blog';
import { EDITORIAL_PHOTOS } from '@/lib/blog-photos';
import { COUNTRIES } from '@/lib/i18n';
import { linkTo, pathFor } from '@/lib/routes';
import { articleJsonLd, breadcrumbJsonLd, faqPageJsonLd } from '@/lib/seo';

interface Props {
  article: EditorialBlogArticle;
}

const { article } = Astro.props;
const { country } = article;
const ui = getUi(country);
const blogUi = ui.editorialBlogUi;
const path = pathFor(article.routeKey, country)!;
const pageId = `blog-${article.id}`;
const heroImg = EDITORIAL_PHOTOS[article.heroPhotoKey];

const crumbs = [
  { name: ui.countryName, path: COUNTRIES[country].basePath },
  { name: 'Blog y recursos', path: linkTo('blog', country) },
  { name: article.category, path },
];
---

<BaseLayout
  pageId={pageId}
  jsonLdNodes={[
    breadcrumbJsonLd(crumbs),
    articleJsonLd({
      headline: article.title,
      description: article.metaDescription,
      path,
      datePublished: article.pubDate,
      dateModified: article.updatedDate,
      authorName: article.author,
      country,
      keywords: article.targetKeyword,
    }),
    ...(article.faqs.length ? [faqPageJsonLd(article.faqs)] : []),
  ]}
  seo={{
    title: article.metaTitle,
    description: article.metaDescription,
    path,
    routeKey: article.routeKey,
    country,
  }}
>
  <Breadcrumbs items={crumbs} ariaLabel={ui.a11y.breadcrumb} />

  <article>
    <!-- Hero Editorial limpio -->
    <header class="container-site pt-6 pb-10 md:pt-10 md:pb-12">
      <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_1fr]">
        <div class="space-y-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-pill border-2 border-ink bg-lemon px-3.5 py-1 text-xs font-bold uppercase">
              {article.eyebrow}
            </span>
            <span class="rounded-pill border border-ink bg-cream-deep px-3 py-1 text-xs font-bold">
              {article.readingTime}
            </span>
          </div>

          <h1 class="text-display-hero">{article.title}</h1>

          <p class="text-lg text-ink-soft md:text-xl leading-relaxed" data-speakable="true">
            {article.intro}
          </p>

          <p class="text-xs font-bold text-ink-soft">
            Por <strong class="text-ink">{article.author}</strong> · {article.authorRole} · Actualizado {article.updatedDate}
          </p>
        </div>

        <figure class="mx-auto w-full max-w-lg lg:max-w-none">
          <div class="overflow-hidden rounded-[28px] border-2 border-ink bg-cream-deep shadow-[8px_10px_0_0_var(--coral)]">
            <Photo
              src={heroImg}
              alt={article.heroPhotoAlt}
              priority
              aspect="4/3"
              widths={[400, 600, 800]}
              sizes="(min-width: 1024px) 44vw, 92vw"
            />
          </div>
        </figure>
      </div>

      <!-- Resumen en 20 segundos (4 datos clave) -->
      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          article.keyFacts.map((fact) => (
            <div class="rounded-2xl border-2 border-ink bg-cream-deep p-4 shadow-[3px_3px_0_0_var(--ink)]">
              <span class="block text-[11px] font-extrabold uppercase text-coral-deep">{fact.label}</span>
              <strong class="mt-1 block text-sm text-ink">{fact.value}</strong>
            </div>
          ))
        }
      </div>
    </header>

    <!-- Cuerpo en 2 columnas: Índice minimal + Secciones escaneables -->
    <div class="container-site py-10 md:py-14">
      <div class="grid items-start gap-10 lg:grid-cols-[240px_1fr] xl:gap-14">
        <aside class="space-y-5 lg:sticky lg:top-24">
          <nav
            aria-label={blogUi.tocTitle}
            class="rounded-[24px] border-2 border-ink bg-cream-deep p-5 shadow-[4px_4px_0_0_var(--ink)]"
          >
            <p class="border-b-2 border-ink pb-2 font-display text-base uppercase">{blogUi.tocTitle}</p>
            <ol class="mt-3 space-y-2 text-xs">
              {
                article.sections.map((sec) => (
                  <li>
                    <a
                      href={`#${sec.id}`}
                      class="group flex items-start gap-2 font-bold text-ink hover:text-coral-deep"
                    >
                      <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded border border-ink bg-lemon text-[10px] font-bold">
                        {sec.number}
                      </span>
                      <span class="leading-snug group-hover:underline">{sec.heading}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>

          <div class="rounded-[24px] border-2 border-ink bg-maroon p-5 text-cream shadow-[4px_4px_0_0_var(--ink)] space-y-3">
            <p class="font-display text-lg uppercase leading-tight text-cream">
              {blogUi.sidebarWaTitle}
            </p>
            <WhatsAppButton
              message={article.waMessage}
              label={blogUi.sidebarWaCta}
              a11yLabel={ui.a11y.openWhatsApp}
              country={country}
              page={pageId}
              placement="sidebar"
              variant="lemon"
              size="md"
              class="w-full justify-center"
            />
          </div>
        </aside>

        <div class="space-y-12">
          {
            article.sections.map((sec) => (
              <section id={sec.id} class="scroll-mt-28 space-y-5">
                <div class="flex items-center gap-3">
                  <span class="inline-flex h-9 w-11 shrink-0 items-center justify-center rounded-xl border-2 border-ink bg-lemon font-display text-lg text-ink">
                    {sec.number}
                  </span>
                  <h2 class="text-display-md">{sec.heading}</h2>
                </div>

                <!-- Idea clave visible en 3 segundos -->
                <p class="rounded-2xl border-l-4 border-coral bg-cream-deep px-5 py-3.5 text-base font-bold text-ink md:text-lg">
                  {sec.lead}
                </p>

                {sec.bullets && (
                  <ul class="grid gap-3 sm:grid-cols-3">
                    {sec.bullets.map((b) => (
                      <li class="flex gap-2 rounded-2xl border-2 border-ink bg-cream p-3.5 text-sm font-bold text-ink">
                        <span class="text-coral-deep" aria-hidden="true">✓</span>
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {sec.scriptBox && (
                  <div class="rounded-[24px] border-2 border-ink bg-sky p-5 shadow-[5px_5px_0_0_var(--ink)] space-y-3">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <h3 class="text-xl">{sec.scriptBox.title}</h3>
                      <span class="rounded-pill border border-ink bg-cream px-2.5 py-0.5 text-xs font-bold uppercase">
                        {sec.scriptBox.badge}
                      </span>
                    </div>
                    <div class="grid gap-3 md:grid-cols-3">
                      {sec.scriptBox.items.map((it) => (
                        <div class="rounded-xl border border-ink bg-cream p-3.5 space-y-1">
                          <strong class="block text-xs font-bold uppercase text-coral-deep">{it.label}</strong>
                          <p class="text-sm font-medium text-ink">{it.text}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {sec.figure && (
                  <figure class="overflow-hidden rounded-[24px] border-2 border-ink bg-cream-deep shadow-[5px_5px_0_0_var(--ink)]">
                    <div class="grid items-center gap-5 p-4 md:grid-cols-[0.85fr_1.15fr] md:p-6">
                      <div class="overflow-hidden rounded-2xl border-2 border-ink bg-cream">
                        <Photo
                          src={EDITORIAL_PHOTOS[sec.figure.photoKey]}
                          alt={sec.figure.alt}
                          aspect="4/3"
                          widths={[360, 540]}
                          sizes="(min-width: 768px) 280px, 88vw"
                        />
                      </div>
                      <div class="space-y-2.5">
                        <span class="inline-block rounded-pill border border-ink bg-sky px-3 py-0.5 text-xs font-bold uppercase text-ink">
                          {sec.figure.badge}
                        </span>
                        <figcaption class="font-bold text-ink leading-snug">
                          {sec.figure.caption}
                        </figcaption>
                        <ul class="space-y-1.5 border-t border-ink/20 pt-2.5 text-sm text-ink-soft">
                          {sec.figure.callouts.map((c) => (
                            <li class="flex items-start gap-2">
                              <span class="mt-0.5 font-bold text-coral-deep" aria-hidden="true">→</span>
                              <span>{c}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  </figure>
                )}

                {/* Explicación en profundidad desplegable (0 KB JS, 100 % indexable por Google) */}
                {sec.paragraphs.length > 0 && (
                  <details class="rounded-2xl border border-ink/40 bg-cream px-4 py-3">
                    <summary class="cursor-pointer list-none text-xs font-extrabold uppercase tracking-wide text-ink-soft hover:text-ink select-none">
                      + Leer explicación detallada ({sec.paragraphs.length} párrafos)
                    </summary>
                    <div class="mt-3 space-y-3 border-t border-ink/15 pt-3 text-sm text-ink-soft md:text-base leading-relaxed">
                      {sec.paragraphs.map((p) => (
                        <p>{p}</p>
                      ))}
                    </div>
                  </details>
                )}
              </section>
            ))
          }

          <!-- Tabla comparativa rápida -->
          <section class="space-y-4 pt-2">
            <h2 class="text-display-md">{article.comparisonTable.title}</h2>
            <div class="overflow-x-auto rounded-[24px] border-2 border-ink bg-cream shadow-[6px_6px_0_0_var(--ink)]">
              <table class="w-full min-w-[600px] border-collapse text-left text-sm">
                <thead>
                  <tr class="border-b-2 border-ink bg-lemon text-ink">
                    {
                      article.comparisonTable.headers.map((h) => (
                        <th class="p-3.5 font-display text-base uppercase">{h}</th>
                      ))
                    }
                  </tr>
                </thead>
                <tbody class="divide-y divide-ink/20">
                  {
                    article.comparisonTable.rows.map((row) => (
                      <tr class="hover:bg-cream-deep/60">
                        <td class="p-3.5 font-bold text-ink">{row.col1}</td>
                        <td class="p-3.5 text-ink-soft">{row.col2}</td>
                        <td class="p-3.5 text-ink-soft">{row.col3}</td>
                        <td class="bg-sky/35 p-3.5 font-bold text-ink">{row.col4}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </section>

          <!-- Checklist práctica -->
          <section class="rounded-[24px] border-2 border-ink bg-lemon p-6 shadow-[6px_6px_0_0_var(--ink)] space-y-4">
            <h2 class="text-display-md">{article.checklist.title}</h2>
            <ul class="grid gap-3 md:grid-cols-2">
              {
                article.checklist.items.map((item, i) => (
                  <li class="flex items-start gap-2.5 rounded-xl border border-ink bg-cream p-3.5 text-sm font-bold text-ink">
                    <span class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-ink bg-coral text-[11px] font-bold text-ink">
                      {i + 1}
                    </span>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </section>

          <!-- Recurso interactivo según el tema -->
          {article.id === 'carruseles' && <CarouselPreviewMockup country={country} compact />}
          {article.id === 'grabacion' && <RecordingTimeline30m country={country} />}

          <!-- Preguntas frecuentes -->
          {
            article.faqs.length > 0 && (
              <section class="space-y-5 pt-2">
                <h2 class="text-display-md">{blogUi.faqTitle}</h2>
                <FAQ items={article.faqs} />
              </section>
            )
          }

          <!-- Cierre de conversión limpio -->
          <footer class="rounded-[28px] border-2 border-ink bg-maroon p-7 text-cream shadow-[8px_8px_0_0_var(--ink)] md:p-9 space-y-4">
            <h2 class="text-display-md text-cream">{ui.finalCta.title}</h2>
            <p class="text-base text-cream/85 md:text-lg">{ui.finalCta.subtitle}</p>
            <div class="flex flex-wrap gap-3 pt-1">
              <WhatsAppButton
                message={article.waMessage}
                label={article.waCta}
                a11yLabel={ui.a11y.openWhatsApp}
                country={country}
                page={pageId}
                placement="article-footer"
                variant="lemon"
                size="lg"
              />
              <BookCallButton
                country={country}
                page={pageId}
                placement="article-footer"
                variant="light"
                size="lg"
              />
            </div>
          </footer>

          <div class="flex flex-wrap items-center gap-2.5 text-sm">
            <a href={linkTo('blog', country)} class="rounded-pill border border-ink bg-cream-deep px-3.5 py-1.5 font-bold text-ink no-underline hover:bg-lemon">
              ← Todos los artículos
            </a>
            <a href={linkTo('precios', country)} class="rounded-pill border border-ink bg-cream-deep px-3.5 py-1.5 font-bold text-ink no-underline hover:bg-lemon">
              Ver precios →
            </a>
            <a href={linkTo('comoTrabajamos', country)} class="rounded-pill border border-ink bg-cream-deep px-3.5 py-1.5 font-bold text-ink no-underline hover:bg-lemon">
              Ver casos reales →
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
