---
import Photo from './Photo.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  text: string;
  href: string;
  linkLabel: string;
  image: ImageMetadata;
  imageAlt: string;
  color?: 'coral' | 'lemon' | 'sky' | 'cream-deep';
  headingLevel?: 'h2' | 'h3';
}
const { title, text, href, linkLabel, image, imageAlt, color = 'lemon', headingLevel: H = 'h3' } = Astro.props;
const bg = { coral: 'bg-coral', lemon: 'bg-lemon', sky: 'bg-sky', 'cream-deep': 'bg-cream-deep' }[color];
---

<article class:list={['niche-card group relative flex flex-col overflow-hidden rounded-[32px] border-2 border-ink text-ink', bg]}>
  <div class="overflow-hidden border-b-2 border-ink">
    <Photo src={image} alt={imageAlt} aspect="4/3" widths={[360, 540, 720]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw" imgClass="transition-transform duration-500 group-hover:scale-105" />
  </div>
  <div class="flex flex-1 flex-col gap-3 p-6">
    <H class="text-2xl md:text-3xl">{title}</H>
    <p class="text-sm md:text-base">{text}</p>
    <a href={href} class="niche-card__link mt-auto inline-flex items-center gap-2 pt-2 font-bold underline underline-offset-4">
      {linkLabel}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
    </a>
  </div>
</article>

<style>
  /* Toda la tarjeta es clicable sin anidar enlaces */
  .niche-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .niche-card :global(img) {
      transform: none !important;
    }
  }
</style>
