---
/**
 * Hero: H1 + promesa + 2 CTA + foto (LCP) + hueco para cara de fundadores.
 * La foto hero es una escena ilustrativa; los fundadores van en placeholder hasta tener foto real.
 */
import Button from './Button.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import BookCallButton from './BookCallButton.astro';
import Sticker from './Sticker.astro';
import Photo from './Photo.astro';
import fundadoraDaniela from '@/assets/photos/feediasocial-fundadora-daniela.webp';
import type { ImageMetadata } from 'astro';
import type { CountryKey } from '@/lib/i18n';
import type { UiCopy } from '@/content/types';

interface Props {
  copy: UiCopy['hero'];
  country: CountryKey;
  page: string;
  waMessage: string;
  waA11y: string;
  secondaryHref: string;
  image: ImageMetadata;
}
const { copy, country, page, waMessage, waA11y, secondaryHref, image } = Astro.props;
---

<section class="hero relative overflow-hidden">
  <div class="container-site grid items-center gap-10 pt-8 pb-14 md:pt-12 lg:grid-cols-[1.15fr_1fr] lg:gap-12 lg:pb-20">
    <div class="relative z-10 flex flex-col gap-6">
      <p class="inline-flex w-fit items-center gap-2 rounded-pill border-2 border-ink bg-sky px-4 py-1.5 text-sm font-bold shadow-[3px_3px_0_0_var(--ink)]">
        <span class="size-2.5 rounded-full bg-coral" aria-hidden="true"></span>
        {copy.eyebrow}
      </p>
      <h1 class="text-display-xl flex flex-col items-start gap-2">
        <span class="block">{copy.title}</span>
        <span class="hero__mark">{copy.titleHighlight}</span>
      </h1>
      <p class="max-w-xl text-lg md:text-xl">{copy.promise}</p>
      <div class="flex flex-wrap items-center gap-3">
        <WhatsAppButton message={waMessage} label={copy.ctaPrimary} a11yLabel={waA11y} country={country} page={page} placement="hero" size="lg" />
        <BookCallButton country={country} page={page} placement="hero" variant="light" size="lg" />
        <Button href={secondaryHref} variant="outline" size="md">{copy.ctaSecondary}</Button>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-md pt-4 pr-4 pb-8 pl-4 lg:max-w-none">
      <div class="hero__photo overflow-hidden rounded-[32px] border-2 border-ink">
        <Photo src={image} alt={copy.photoAlt} priority aspect="4/5" widths={[360, 480, 640, 800]} sizes="(min-width: 1024px) 42vw, 92vw" />
      </div>
      <div class=" (founder-badge) absolute bottom-2 left-0 z-10 flex items-center gap-2.5 rounded-2xl border-2 border-ink bg-lemon p-2 pr-3.5 text-ink shadow-[4px_4px_0_0_var(--ink)] rotate-[-3deg]">
        <div class="size-12 shrink-0 overflow-hidden rounded-xl border-2 border-ink bg-cream">
          <Photo src={fundadoraDaniela} alt={copy.founderPlaceholder} aspect="3/4" widths={[120]} sizes="48px" />
        </div>
        <div class="text-left leading-tight">
          <strong class="block font-display text-sm uppercase">Daniela · Fundadora</strong>
          <span class="block text-[11px] font-bold text-ink-soft">Trato directo · España y México</span>
        </div>
      </div>
      <Sticker color="coral" shape="circle" rotate={10} class="absolute top-0 right-0 z-10">{copy.stickers[1]}</Sticker>
      <Sticker color="sky" rotate={-6} class="absolute top-6 left-0 z-10 hidden text-xs! sm:inline-flex">{copy.stickers[0]}</Sticker>
    </div>
  </div>
</section>

<style>
  .hero__mark {
    display: inline-block;
    background: var(--lemon);
    color: var(--ink);
    line-height: 1.05;
    padding: 0.14em 0.28em 0.1em;
    border-radius: 0.22em;
    border: 2px solid var(--ink);
    box-shadow: 4px 4px 0 0 var(--ink);
  }
  :global([data-theme='sober']) .hero__mark {
    background: var(--cream-deep);
    color: var(--maroon);
  }
  .hero__photo {
    box-shadow: 10px 12px 0 0 var(--accent-1);
  }
</style>
