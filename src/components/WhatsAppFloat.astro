---
/**
 * Botón flotante de WhatsApp (solo móvil). No tapa contenido: el body reserva
 * espacio inferior, y sube por encima del banner de cookies vía --cookie-offset.
 */
import { waLink } from '@/lib/whatsapp';
import type { CountryKey } from '@/lib/i18n';

interface Props {
  country: CountryKey;
  page: string;
  message: string;
  label: string;
  a11yLabel: string;
}
const { country, page, message, label, a11yLabel } = Astro.props;
const href = waLink(message, { country, page, placement: 'float' });
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class="wa-float md:hidden"
  aria-label={`${label}. ${a11yLabel}`}
  data-wa
  data-wa-page={page}
  data-wa-country={country}
  data-wa-placement="float"
>
  <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor">
    <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.5-.2Z"></path>
  </svg>
  <span class="wa-float__label">{label}</span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: calc(max(1rem, env(safe-area-inset-bottom)) + var(--cookie-offset, 0px));
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--wa-float-size);
    padding: 0 1.25rem 0 1rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--lemon);
    border: 2px solid var(--lemon);
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 8px 24px rgb(27 27 31 / 0.25);
    transition: bottom 0.25s ease;
  }
  .wa-float__label {
    font-size: 1rem;
  }
  @media (width < 48rem) {
    :global(body) {
      padding-bottom: calc(var(--wa-float-size) + 2rem);
    }
  }
</style>
