---
/**
 * Barra flotante móvil de doble acción (Llamada 15m en Calendly + WhatsApp).
 * No tapa contenido: el body reserva espacio inferior, y sube por encima del banner de cookies vía --cookie-offset.
 */
import { waLink } from '@/lib/whatsapp';
import { bookCallLink } from '@/lib/calendly';
import { getUi } from '@/content';
import type { CountryKey } from '@/lib/i18n';

interface Props {
  country: CountryKey;
  page: string;
  message: string;
  label: string;
  a11yLabel: string;
}
const { country, page, message, label, a11yLabel } = Astro.props;
const ui = getUi(country);
const waHref = waLink(message, { country, page, placement: 'float' });
const callHref = bookCallLink({ country, page, placement: 'float' });
---

<div class="float-dock md:hidden" role="region" aria-label={label}>
  <a
    href={callHref}
    target="_blank"
    rel="noopener noreferrer"
    class="float-dock__call"
    aria-label={`${ui.bookCall.ctaShort}. ${ui.bookCall.a11yLabel}`}
    data-calendly
    data-calendly-page={page}
    data-calendly-country={country}
    data-calendly-placement="float"
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <rect x="3" y="4" width="18" height="18" rx="3"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
      <circle cx="12" cy="15.5" r="2.2"></circle>
    </svg>
    <span>{ui.bookCall.ctaShort}</span>
  </a>

  <a
    href={waHref}
    target="_blank"
    rel="noopener"
    class="float-dock__wa"
    aria-label={`${label}. ${a11yLabel}`}
    data-wa
    data-wa-page={page}
    data-wa-country={country}
    data-wa-placement="float"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor">
      <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.5-.2Z"></path>
    </svg>
    <span>{label}</span>
  </a>
</div>

<style>
  .float-dock {
    position: fixed;
    right: max(0.75rem, env(safe-area-inset-right));
    bottom: calc(max(0.85rem, env(safe-area-inset-bottom)) + var(--cookie-offset, 0px));
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: bottom 0.25s ease;
  }
  .float-dock__call,
  .float-dock__wa {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 3rem;
    padding: 0 0.95rem;
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.85rem;
    text-decoration: none;
    box-shadow: 0 6px 18px rgb(27 27 31 / 0.25);
  }
  .float-dock__call {
    background: var(--cream);
    color: var(--ink);
    border: 2px solid var(--ink);
  }
  .float-dock__wa {
    background: var(--ink);
    color: var(--lemon);
    border: 2px solid var(--lemon);
  }
  @media (width < 48rem) {
    :global(body) {
      padding-bottom: calc(var(--wa-float-size) + 2rem);
    }
  }
</style>
