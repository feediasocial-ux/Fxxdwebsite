---
import WhatsAppButton from './WhatsAppButton.astro';
import Sticker from './Sticker.astro';
import { formatPrice, type CountryKey } from '@/lib/i18n';
import type { Package } from '@/content/pricing';
import { getUi } from '@/content';

interface Props {
  pkg: Package;
  country: CountryKey;
  page: string;
  headingLevel?: 'h2' | 'h3';
}
const { pkg, country, page, headingLevel: H = 'h3' } = Astro.props;
const ui = getUi(country);
const styles = {
  cream: 'bg-cream-deep text-ink',
  coral: 'bg-coral text-ink',
  maroon: 'bg-maroon text-cream',
}[pkg.color];
const message = ui.pricing.waMessage.replace('{name}', pkg.name);
---

<article class:list={['package relative flex flex-col gap-6 rounded-[32px] border-2 border-ink p-7 md:p-8', styles, pkg.featured && 'md:-translate-y-4 shadow-[0_8px_0_0_var(--ink)]']}>
  {
    pkg.featured && (
      <Sticker color="lemon" rotate={6} class="absolute -top-5 right-6">
        {ui.pricing.popular}
      </Sticker>
    )
  }
  <H class="text-display-md">{pkg.name}</H>
  <p class="flex items-baseline gap-1">
    <span class="font-display text-5xl leading-none md:text-6xl">{formatPrice(pkg.price[country], country)}</span>
    <span class="font-bold">{ui.pricing.perMonth}</span>
  </p>
  <ul class="space-y-2.5">
    {
      pkg.features[country].map((f) => (
        <li class="flex gap-2.5">
          <svg class="mt-1 shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M4 12l5 5L20 6"></path></svg>
          <span>{f}</span>
        </li>
      ))
    }
  </ul>
  <div class="mt-auto pt-2">
    <WhatsAppButton
      message={message}
      label={ui.pricing.cta}
      a11yLabel={ui.a11y.openWhatsApp}
      country={country}
      page={page}
      placement={`pricing-${pkg.id}`}
      variant={pkg.color === 'maroon' ? 'lemon' : 'dark'}
      class="w-full"
    />
  </div>
</article>
