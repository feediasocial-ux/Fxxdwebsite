---
import Logo from './Logo.astro';
import CountrySwitcher from './CountrySwitcher.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import BookCallButton from './BookCallButton.astro';
import { getUi } from '@/content';
import { getNichesByCountry } from '@/content/niches';
import { ROUTES, linkTo, pathFor, type RouteKey } from '@/lib/routes';
import type { CountryKey } from '@/lib/i18n';

interface Props {
  country: CountryKey;
  routeKey?: RouteKey;
  page: string;
}
const { country, routeKey, page } = Astro.props;
const ui = getUi(country);
const nav = ui.header.nav.filter((n) => ROUTES[n.route].live);
const niches = getNichesByCountry(country);
---

<header class="site-header sticky top-0 z-30 border-b-2 border-ink bg-cream/95 backdrop-blur-sm">
  <div class="container-site flex min-h-16 items-center justify-between gap-2.5 py-2">
    <Logo href={linkTo('home', country)} label={ui.a11y.logoHome} />
    {
      nav.length > 0 && (
        <nav aria-label={ui.a11y.mainNav} class="hidden lg:block">
          <ul class="flex items-center gap-6 font-bold">
            {nav.map((n) => (
              <li>
                <a
                  href={linkTo(n.route, country)}
                  class="underline-offset-4 hover:underline"
                  aria-current={routeKey === n.route ? 'page' : undefined}
                >
                  {n.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <div class="flex items-center gap-2">
      <CountrySwitcher
        current={country}
        routeKey={routeKey}
        label={ui.countrySwitcher.label}
        a11yLabel={ui.a11y.countrySwitcher}
      />
      <BookCallButton
        country={country}
        page={page}
        placement="header"
        label={ui.bookCall.ctaShort}
        variant="light"
        class="hidden min-h-11! px-3.5! text-xs! xl:inline-flex"
      />
      <WhatsAppButton
        message={ui.whatsapp.defaultMessage}
        label={ui.header.waCtaShort}
        a11yLabel={ui.a11y.openWhatsApp}
        country={country}
        page={page}
        placement="header"
        class="hidden min-h-11! px-4! text-sm! md:inline-flex"
      />

      <!-- Menú móvil neo-brutalista (< 1024px) -->
      <details class="mobile-menu lg:hidden" data-mobile-menu>
        <summary
          class="inline-flex min-h-11 cursor-pointer list-none items-center gap-1.5 rounded-pill border-2 border-ink bg-lemon px-3.5 text-xs font-extrabold uppercase text-ink shadow-[3px_3px_0_0_var(--ink)] select-none"
          aria-label={ui.mobileMenu.openLabel}
        >
          <svg
            class="mobile-menu__icon-open"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.6"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="3" y1="7" x2="21" y2="7"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="17" x2="21" y2="17"></line>
          </svg>
          <svg
            class="mobile-menu__icon-close hidden"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.6"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="6" y1="6" x2="18" y2="18"></line>
            <line x1="6" y1="18" x2="18" y2="6"></line>
          </svg>
          <span>{ui.mobileMenu.openLabel}</span>
        </summary>

        <div class="fixed inset-x-0 top-[66px] z-40 border-b-2 border-ink bg-cream p-5 shadow-[0_12px_0_0_var(--ink)]">
          <div class="container-site max-h-[calc(100dvh-90px)] space-y-5 overflow-y-auto pb-4">
            <div>
              <p class="text-[11px] font-extrabold tracking-wider uppercase text-ink-soft">
                {ui.mobileMenu.sectionsLabel}
              </p>
              <nav aria-label={ui.a11y.mainNav} class="mt-2.5">
                <ul class="grid grid-cols-2 gap-2.5">
                  {nav.map((n, idx) => (
                    <li>
                      <a
                        href={linkTo(n.route, country)}
                        class:list={[
                          'flex items-center gap-2 rounded-2xl border-2 border-ink px-3.5 py-2.5 text-sm font-bold text-ink no-underline shadow-[3px_3px_0_0_var(--ink)]',
                          routeKey === n.route ? 'bg-lemon' : 'bg-cream-deep hover:bg-lemon',
                        ]}
                        aria-current={routeKey === n.route ? 'page' : undefined}
                      >
                        <span class="font-display text-base text-coral-deep">0{idx + 1}</span>
                        <span>{n.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>

            <div>
              <p class="text-[11px] font-extrabold tracking-wider uppercase text-ink-soft">
                {ui.mobileMenu.nichesLabel}
              </p>
              <div class="mt-2 flex flex-wrap gap-2">
                {niches.map((niche) => (
                  <a
                    href={pathFor(niche.routeKey, country)!}
                    class="rounded-pill border border-ink bg-cream-deep px-3 py-1.5 text-xs font-bold text-ink no-underline hover:bg-sky"
                  >
                    {niche.shortTitle}
                  </a>
                ))}
              </div>
            </div>

            <div class="grid gap-2.5 border-t-2 border-ink/15 pt-4 sm:grid-cols-2">
              <WhatsAppButton
                message={ui.whatsapp.defaultMessage}
                label={ui.header.waCta}
                a11yLabel={ui.a11y.openWhatsApp}
                country={country}
                page={page}
                placement="mobile-menu"
                size="md"
                class="w-full justify-center"
              />
              <BookCallButton
                country={country}
                page={page}
                placement="mobile-menu"
                variant="light"
                size="md"
                class="w-full justify-center"
              />
            </div>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .mobile-menu > summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu[open] > summary {
    background: var(--coral);
  }
  .mobile-menu[open] .mobile-menu__icon-open {
    display: none;
  }
  .mobile-menu[open] .mobile-menu__icon-close {
    display: block;
  }
</style>

<script is:inline>
  (function () {
    var menu = document.querySelector('[data-mobile-menu]');
    if (!menu) return;
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && menu.hasAttribute('open')) {
        menu.removeAttribute('open');
      }
    });
    menu.addEventListener('click', function (e) {
      var link = e.target && e.target.closest ? e.target.closest('a') : null;
      if (link) menu.removeAttribute('open');
    });
  })();
</script>
