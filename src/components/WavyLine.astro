---
/**
 * Trazo ondulado que guía la lectura, con texto sobre la línea (SVG estático).
 * Decorativo: el texto se repite en el contenido, por eso va aria-hidden.
 */
interface Props {
  text: string;
  color?: string;
  textColor?: string;
  class?: string;
}
const { text, color = 'var(--coral)', textColor = 'var(--ink)', class: cls = '' } = Astro.props;
const id = `wave-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class:list={['wavy-line w-full h-auto py-2', cls]} viewBox="0 0 1200 130" aria-hidden="true" focusable="false">
  <defs>
    <path id={id} d="M 0,88 Q 300,48 600,82 T 1200,72"></path>
  </defs>
  <use href={`#${id}`} fill="none" stroke={color} stroke-width="12" stroke-linecap="round"></use>
  <text fill={textColor} font-family="var(--font-display)" font-size="22" letter-spacing="3">
    <textPath href={`#${id}`} startOffset="2%" dy="-12">{`${text.toUpperCase()} · ${text.toUpperCase()} · ${text.toUpperCase()}`}</textPath>
  </text>
</svg>

<style>
  .wavy-line text {
    dominant-baseline: text-after-edge;
  }
</style>
