---
/** Paso numerado (01, 02, 03…) en tarjeta de color. */
interface Props {
  n: number;
  title: string;
  text: string;
  color?: 'coral' | 'lemon' | 'sky' | 'cream-deep' | 'accent-1' | 'accent-2' | 'accent-3';
  headingLevel?: 'h3' | 'h4';
}
const { n, title, text, color = 'lemon', headingLevel: H = 'h3' } = Astro.props;
const bg = {
  coral: 'bg-coral',
  lemon: 'bg-lemon',
  sky: 'bg-sky',
  'cream-deep': 'bg-cream-deep',
  'accent-1': 'bg-accent-1',
  'accent-2': 'bg-accent-2',
  'accent-3': 'bg-accent-3',
}[color];
---

<li class:list={['step relative flex flex-col gap-3 rounded-[28px] border-2 border-ink p-6 text-ink md:p-8', bg]}>
  <span class="step__n font-display text-6xl leading-none md:text-7xl" aria-hidden="true">{String(n).padStart(2, '0')}</span>
  <H class="text-2xl md:text-3xl">{title}</H>
  <p>{text}</p>
</li>

<style>
  .step__n {
    -webkit-text-stroke: 2px var(--ink);
    color: transparent;
  }
  :global([data-theme='sober']) .step.bg-accent-1 {
    color: var(--cream);
  }
  :global([data-theme='sober']) .step.bg-accent-1 .step__n {
    -webkit-text-stroke-color: var(--cream);
  }
</style>
