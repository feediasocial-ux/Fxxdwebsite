---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import PhoneReelMockup from '@/components/PhoneReelMockup.astro';
import VideoPlaceholder from '@/components/VideoPlaceholder.astro';
import Photo from '@/components/Photo.astro';
import { getPhase4, getUi } from '@/content';
import { COUNTRIES, type CountryKey } from '@/lib/i18n';
import { linkTo, pathFor } from '@/lib/routes';
import { breadcrumbJsonLd, serviceJsonLd } from '@/lib/seo';

import mesaTrabajo from '@/assets/photos/feediasocial-mesa-trabajo-pantone.webp';
import estudioEdicion from '@/assets/photos/feediasocial-estudio-edicion.webp';
import resultadosPorton from '@/assets/photos/feediasocial-resultados-porton-maya.webp';
import resultadosCedres from '@/assets/photos/feediasocial-resultados-cedres.webp';
import casoCopimax from '@/assets/photos/feediasocial-caso-copimax.webp';
import casoDolorfin from '@/assets/photos/feediasocial-caso-dolorfin-clinica.webp';
import casoMudra from '@/assets/photos/feediasocial-caso-mudra-pilates.webp';
import casoCedres from '@/assets/photos/feediasocial-caso-cedres-musica.webp';

interface Props {
  country: CountryKey;
}

const { country } = Astro.props;
const ui = getUi(country);
const copy = getPhase4(country).comoTrabajamos;
const path = pathFor('comoTrabajamos', country)!;
const crumbs = [
  { name: ui.countryName, path: COUNTRIES[country].basePath },
  { name: 'Casos', path },
];
const featuredScript = copy.scriptSamples[0];
---

<BaseLayout
  pageId="como-trabajamos"
  jsonLdNodes={[
    breadcrumbJsonLd(crumbs),
    ...serviceJsonLd({
      name: copy.h1,
      description: copy.metaDescription,
      path,
      country,
      serviceType: 'Social Media Scriptwriting, Editing & Content Calendar',
    }),
  ]}
  seo={{
    title: copy.metaTitle,
    description: copy.metaDescription,
    path,
    routeKey: 'comoTrabajamos',
    country,
  }}
>
  <Breadcrumbs items={crumbs} ariaLabel={ui.a11y.breadcrumb} />

  <section class="container-site pt-6 pb-14 md:pt-10 md:pb-16">
    <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_1fr]">
      <div class="space-y-5">
        <p class="inline-block rounded-pill border-2 border-ink bg-coral px-4 py-1 text-sm font-bold uppercase shadow-[3px_3px_0_0_var(--ink)]">
          {copy.eyebrow}
        </p>
        <h1 class="text-display-hero">{copy.h1}</h1>
        <p class="text-lg text-ink-soft md:text-xl">{copy.intro}</p>
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <WhatsAppButton
            message={copy.waMessage}
            label={copy.waCta}
            a11yLabel={ui.a11y.openWhatsApp}
            country={country}
            page="como-trabajamos"
            placement="hero"
            size="lg"
          />
          <Button href={linkTo('precios', country)} variant="outline" size="lg">
            {ui.hero.ctaSecondary}
          </Button>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="overflow-hidden rounded-[28px] border-2 border-ink shadow-[8px_8px_0_0_var(--coral)]">
          <Photo src={mesaTrabajo} alt={copy.samplesTitle} priority aspect="4/5" widths={[360, 540]} sizes="45vw" />
        </div>
        <div class="mt-6 overflow-hidden rounded-[28px] border-2 border-ink shadow-[8px_8px_0_0_var(--lemon)]">
          <Photo src={estudioEdicion} alt={copy.calendarShowcaseTitle} aspect="4/5" widths={[360, 540]} sizes="45vw" />
        </div>
      </div>
    </div>
  </section>

  <!-- Casos reales: Antes / Después y cuentas trabajadas desde el estudio -->
  <section class="container-site py-12 md:py-20">
    <div class="max-w-3xl space-y-3">
      <span class="inline-block rounded-pill border-2 border-ink bg-lemon px-3.5 py-1 text-xs font-bold uppercase">
        Portfolio real · Antes y después
      </span>
      <h2 class="text-display-lg">Cuentas reales que gestionamos y evolución visual del feed</h2>
      <p class="text-lg text-ink-soft">
        Capturas directas de perfiles reales trabajados por Daniela y el estudio: estructura de biografía, historias destacadas, portadas coherentes y Reels con retención.
      </p>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      <div class="rounded-[32px] border-2 border-ink bg-cream-deep p-5 shadow-[8px_8px_0_0_var(--ink)]">
        <div class="overflow-hidden rounded-[22px] border-2 border-ink">
          <Photo
            src={resultadosPorton}
            alt="Antes y después real del perfil de restaurante Portón Maya gestionado por Feediasocial"
            aspect="9/16"
            widths={[360, 540, 720]}
            sizes="(min-width: 1024px) 44vw, 92vw"
          />
        </div>
        <h3 class="mt-4 text-2xl">Restauración · Portón Maya</h3>
        <p class="mt-1 text-sm text-ink-soft">
          De un perfil desordenado a una identidad clara con historias destacadas por categoría, vídeo gastronómico real y crecimiento constante de seguidores y clientes.
        </p>
      </div>

      <div class="rounded-[32px] border-2 border-ink bg-cream-deep p-5 shadow-[8px_8px_0_0_var(--ink)]">
        <div class="overflow-hidden rounded-[22px] border-2 border-ink">
          <Photo
            src={resultadosCedres}
            alt="Antes y después real de @cedresmusica: de 1.455 a 19,1 mil seguidores con sistema de Reels"
            aspect="9/16"
            widths={[360, 540, 720]}
            sizes="(min-width: 1024px) 44vw, 92vw"
          />
        </div>
        <h3 class="mt-4 text-2xl">Marca personal · Cedres (19,1 mil seguidores)</h3>
        <p class="mt-1 text-sm text-ink-soft">
          Definición de formato propio en vídeo vertical («Misceláneas Musicales»), portadas unificadas y salto de 374 visualizaciones a Reels de 62,6 mil y 97,5 mil reproducciones.
        </p>
      </div>
    </div>

    <div class="mt-8 grid grid-cols-2 gap-5 lg:grid-cols-4">
      <div class="rounded-[24px] border-2 border-ink bg-cream-deep p-3.5 shadow-[5px_5px_0_0_var(--ink)]">
        <div class="overflow-hidden rounded-2xl border border-ink">
          <Photo src={casoCopimax} alt="Perfil de Instagram de Copimax Iztacalco con Reels de 1,2 M y 12,4 M de visualizaciones" aspect="9/16" widths={[280, 420]} sizes="(min-width: 1024px) 22vw, 45vw" />
        </div>
        <p class="mt-2.5 text-xs font-extrabold uppercase text-coral-deep">Negocio local · Copimax</p>
        <p class="mt-0.5 text-xs font-bold text-ink">Reels orgánicos de 42,5 mil, 1,2 M y 12,4 M de visualizaciones.</p>
      </div>

      <div class="rounded-[24px] border-2 border-ink bg-cream-deep p-3.5 shadow-[5px_5px_0_0_var(--ink)]">
        <div class="overflow-hidden rounded-2xl border border-ink">
          <Photo src={casoDolorfin} alt="Perfil de Instagram de Dolorfin Quiroprácticos con 22 sucursales" aspect="9/16" widths={[280, 420]} sizes="(min-width: 1024px) 22vw, 45vw" />
        </div>
        <p class="mt-2.5 text-xs font-extrabold uppercase text-coral-deep">Salud · Dolorfin Clínicas</p>
        <p class="mt-0.5 text-xs font-bold text-ink">22 clínicas · Carruseles educativos y divulgación sanitaria rigurosa.</p>
      </div>

      <div class="rounded-[24px] border-2 border-ink bg-cream-deep p-3.5 shadow-[5px_5px_0_0_var(--ink)]">
        <div class="overflow-hidden rounded-2xl border border-ink">
          <Photo src={casoMudra} alt="Perfil de Instagram de estudio Mudra Pilates Reformer" aspect="9/16" widths={[280, 420]} sizes="(min-width: 1024px) 22vw, 45vw" />
        </div>
        <p class="mt-2.5 text-xs font-extrabold uppercase text-coral-deep">Fitness y Bienestar · Mudra Pilates</p>
        <p class="mt-0.5 text-xs font-bold text-ink">Dirección de arte limpia, portadas editoriales y agenda por DM/WhatsApp.</p>
      </div>

      <div class="rounded-[24px] border-2 border-ink bg-cream-deep p-3.5 shadow-[5px_5px_0_0_var(--ink)]">
        <div class="overflow-hidden rounded-2xl border border-ink">
          <Photo src={casoCedres} alt="Perfil de Instagram de Cedres con serie de Reels" aspect="9/16" widths={[280, 420]} sizes="(min-width: 1024px) 22vw, 45vw" />
        </div>
        <p class="mt-2.5 text-xs font-extrabold uppercase text-coral-deep">Identidad visual · Cedres</p>
        <p class="mt-0.5 text-xs font-bold text-ink">Cuadrícula ordenada por series y retención constante en Reels.</p>
      </div>
    </div>
  </section>

  <!-- Ejemplo de entregable: 1 guion real + calendario mensual -->
  <section class="theme-dark py-16 md:py-24">
    <div class="container-site space-y-12">
      <div class="max-w-3xl space-y-3">
        <h2 class="text-display-lg text-cream">{copy.samplesTitle}</h2>
        <p class="text-lg text-cream/85">{copy.samplesSubtitle}</p>
      </div>

      <div class="grid items-start gap-8 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="space-y-6">
          <VideoPlaceholder
            badge="Showreel · Reels reales"
            title="Showreel de Reels editados"
            subtitle={
              country === 'es'
                ? 'Cortes rápidos (20–30 s) de edición, subtítulos dinámicos y ganchos visuales reales del estudio.'
                : 'Cortes rápidos (20–30 s) de edición, subtítulos dinámicos y ganchos visuales reales del estudio.'
            }
            pendingTag="[PENDIENTE: subir public/videos/showreel-reels.mp4]"
            accent="lemon"
          />
          <div class="text-ink">
            <PhoneReelMockup
              country={country}
              badge={featuredScript.nicheBadge}
              duration={featuredScript.duration}
              title={featuredScript.title}
              hook={featuredScript.hook}
              shots={featuredScript.body}
              cta={featuredScript.cta}
              shotNote={featuredScript.shotNote}
              accent={featuredScript.color}
            />
          </div>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          {
            copy.calendarWeeks.map((w) => (
              <div class="space-y-3 rounded-[24px] border-2 border-cream bg-cream p-5 text-ink shadow-[6px_6px_0_0_var(--coral)]">
                <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-ink/20 pb-2">
                  <h3 class="text-xl">{w.week}</h3>
                  <span class="text-[11px] font-bold uppercase text-coral-deep">{w.goal}</span>
                </div>
                <ul class="space-y-2.5">
                  {w.deliverables.map((d) => (
                    <li class="rounded-xl border border-ink bg-cream-deep p-3">
                      <span class="inline-block rounded-pill border border-ink bg-lemon px-2 py-0.5 text-[10px] font-bold uppercase">
                        {d.day} · {d.format}
                      </span>
                      <p class="mt-1 text-xs font-bold">{d.piece}</p>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- CTA final limpio -->
  <section class="container-site py-16 md:py-20">
    <div class="flex flex-col items-start justify-between gap-6 rounded-[32px] border-2 border-ink bg-maroon p-8 text-cream shadow-[8px_8px_0_0_var(--ink)] lg:flex-row lg:items-center md:p-10">
      <div class="max-w-2xl space-y-2">
        <h2 class="text-display-md text-cream">{copy.pilotCtaTitle}</h2>
        <p class="text-base text-cream/85 md:text-lg">{copy.pilotCtaText}</p>
      </div>
      <div class="flex flex-wrap gap-3 shrink-0">
        <WhatsAppButton
          message={copy.waMessage}
          label={copy.waCta}
          a11yLabel={ui.a11y.openWhatsApp}
          country={country}
          page="como-trabajamos"
          placement="final-cta"
          variant="lemon"
          size="lg"
        />
        <Button href={linkTo('precios', country)} variant="outline" size="lg" class="border-cream! text-cream! hover:bg-cream! hover:text-ink!">
          {ui.hero.ctaSecondary}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
