---
/** Marco de teléfono solo CSS para capturas de reels/calendarios. */
interface Props {
  class?: string;
  tilt?: number;
}
const { class: cls = '', tilt = 0 } = Astro.props;
---

<div class:list={['phone', cls]} style={`--tilt:${tilt}deg`}>
  <div class="phone__screen">
    <slot />
  </div>
</div>

<style>
  .phone {
    width: min(100%, 17rem);
    aspect-ratio: 9 / 19;
    padding: 0.55rem;
    border-radius: 2.6rem;
    background: var(--ink);
    box-shadow: 8px 10px 0 0 var(--coral);
    transform: rotate(var(--tilt));
    position: relative;
  }
  .phone::before {
    content: '';
    position: absolute;
    top: 1.1rem;
    left: 50%;
    width: 30%;
    height: 1.1rem;
    transform: translateX(-50%);
    background: var(--ink);
    border-radius: 999px;
    z-index: 2;
  }
  .phone__screen {
    width: 100%;
    height: 100%;
    border-radius: 2.1rem;
    overflow: hidden;
    background: var(--cream-deep);
  }
  .phone__screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
