---
/**
 * Comparador visual real: «Sin sistema (improvisando)» vs. «Con el sistema Feediasocial»
 * acompañado de 2 capturas reales de Antes / Después gestionadas por el estudio.
 */
import Photo from '@/components/Photo.astro';
import { getUi } from '@/content';
import type { CountryKey } from '@/lib/i18n';
import resultadosPorton from '@/assets/photos/feediasocial-resultados-porton-maya.webp';
import resultadosCedres from '@/assets/photos/feediasocial-resultados-cedres.webp';

interface Props {
  country: CountryKey;
}

const { country } = Astro.props;
const copy = getUi(country).feedComparison;
---

<section class="container-site py-16 md:py-24">
  <div class="max-w-3xl space-y-3">
    <p class="inline-block rounded-pill border-2 border-ink bg-lemon px-4 py-1 text-sm font-bold uppercase shadow-[3px_3px_0_0_var(--ink)]">
      {copy.eyebrow}
    </p>
    <h2 class="text-display-lg">{copy.title}</h2>
    <p class="text-lg text-ink-soft">{copy.subtitle}</p>
  </div>

  <div class="mt-10 grid items-center gap-8 lg:grid-cols-[0.95fr_1.05fr]">
    <!-- Columna Izquierda: Comparativa clara Sin sistema vs. Con sistema -->
    <div class="space-y-6">
      <div class="rounded-[28px] border-2 border-dashed border-ink bg-cream-deep p-6 text-ink shadow-[6px_6px_0_0_var(--ink)] md:p-7">
        <span class="inline-block rounded-pill border border-ink bg-cream px-3 py-1 text-xs font-extrabold uppercase text-coral-deep">
          ✕ {copy.beforeBadge}
        </span>
        <h3 class="mt-3 text-2xl md:text-3xl">{copy.beforeTitle}</h3>
        <ul class="mt-4 space-y-2.5 text-sm text-ink-soft md:text-base">
          {
            copy.beforePains.map((pain) => (
              <li class="flex items-start gap-2.5">
                <span class="font-bold text-coral-deep" aria-hidden="true">✕</span>
                <span>{pain}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-[28px] border-2 border-ink bg-ink p-6 text-cream shadow-[8px_8px_0_0_var(--coral)] md:p-7">
        <span class="inline-block rounded-pill border-2 border-ink bg-lemon px-3 py-1 text-xs font-extrabold uppercase text-ink">
          ✓ {copy.afterBadge}
        </span>
        <h3 class="mt-3 text-2xl text-cream md:text-3xl">{copy.afterTitle}</h3>
        <ul class="mt-4 space-y-2.5 text-sm text-cream/90 md:text-base">
          {
            copy.afterWins.map((win) => (
              <li class="flex items-start gap-2.5">
                <span class="font-bold text-lemon" aria-hidden="true">✓</span>
                <span>{win}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Columna Derecha: 2 resultados reales de Antes / Después -->
    <div class="grid grid-cols-2 gap-4 sm:gap-6">
      <figure class="overflow-hidden rounded-[24px] border-2 border-ink bg-cream-deep p-2.5 shadow-[6px_6px_0_0_var(--ink)] sm:p-3">
        <div class="overflow-hidden rounded-[16px] border border-ink">
          <Photo
            src={resultadosPorton}
            alt="Antes y después real del perfil de restaurante Portón Maya gestionado por Feediasocial"
            aspect="9/16"
            widths={[280, 420]}
            sizes="(min-width: 1024px) 24vw, 45vw"
          />
        </div>
        <figcaption class="mt-2.5 text-xs font-bold text-ink">
          Portón Maya · Orden visual y reels reales
        </figcaption>
      </figure>

      <figure class="overflow-hidden rounded-[24px] border-2 border-ink bg-cream-deep p-2.5 shadow-[6px_6px_0_0_var(--ink)] sm:p-3">
        <div class="overflow-hidden rounded-[16px] border border-ink">
          <Photo
            src={resultadosCedres}
            alt="Antes y después real de Cedres: de 1.455 a 19,1 mil seguidores con sistema de Reels"
            aspect="9/16"
            widths={[280, 420]}
            sizes="(min-width: 1024px) 24vw, 45vw"
          />
        </div>
        <figcaption class="mt-2.5 text-xs font-bold text-ink">
          Cedres · De 1.455 a 19,1 mil seguidores
        </figcaption>
      </figure>
    </div>
  </div>
</section>
