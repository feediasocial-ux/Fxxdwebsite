---
/**
 * Sello de Metodología Editorial Verificable (E-E-A-T para Google Search y motores GEO).
 */
import { getUi } from '@/content';
import type { CountryKey } from '@/lib/i18n';

interface Props {
  country: CountryKey;
  updatedDate?: string;
}

const { country, updatedDate } = Astro.props;
const copy = getUi(country).eeatBox;
---

<aside
  aria-label={copy.badge}
  class="rounded-[28px] border-2 border-ink bg-cream-deep p-6 text-ink shadow-[6px_6px_0_0_var(--ink)] md:p-8"
>
  <div class="space-y-3">
    <div class="flex flex-wrap items-center gap-2">
      <span class="inline-block rounded-pill border border-ink bg-sky px-3 py-1 text-xs font-extrabold uppercase">
        {copy.badge}
      </span>
      {updatedDate && (
        <span class="inline-block rounded-pill border border-ink bg-cream px-3 py-1 text-xs font-bold text-ink-soft">
          {updatedDate}
        </span>
      )}
    </div>
    <h2 class="text-2xl md:text-3xl">{copy.title}</h2>
    <p class="text-sm text-ink-soft md:text-base">{copy.text}</p>
  </div>

  <dl class="mt-5 grid gap-3 sm:grid-cols-3">
    {
      copy.pillars.map((p) => (
        <div class="rounded-2xl border-2 border-ink bg-cream p-3.5">
          <dt class="text-[11px] font-extrabold uppercase tracking-wider text-coral-deep">{p.label}</dt>
          <dd class="mt-1 text-xs font-bold text-ink md:text-sm">{p.value}</dd>
        </div>
      ))
    }
  </dl>
</aside>
