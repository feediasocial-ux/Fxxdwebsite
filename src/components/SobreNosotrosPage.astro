---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Card from '@/components/Card.astro';
import Photo from '@/components/Photo.astro';
import Sticker from '@/components/Sticker.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import BookCallButton from '@/components/BookCallButton.astro';
import StripeBand from '@/components/StripeBand.astro';
import { getCorePages, getUi } from '@/content';
import { COUNTRIES, type CountryKey } from '@/lib/i18n';
import { pathFor } from '@/lib/routes';
import { abs, breadcrumbJsonLd } from '@/lib/seo';

import equipoEscritorio from '@/assets/photos/feediasocial-equipo-escritorio.webp';
import fundadoraDaniela from '@/assets/photos/feediasocial-fundadora-daniela.webp';
import mesaTrabajo from '@/assets/photos/feediasocial-mesa-trabajo-pantone.webp';
import estudioEdicion from '@/assets/photos/feediasocial-estudio-edicion.webp';

interface Props {
  country: CountryKey;
}
const { country } = Astro.props;
const ui = getUi(country);
const copy = getCorePages(country).sobreNosotros;
const path = pathFor('sobreNosotros', country)!;
const crumbs = [
  { name: ui.countryName, path: COUNTRIES[country].basePath },
  { name: 'Sobre nosotros', path },
];

// JSON-LD Person para la fundadora Daniela
const foundersJsonLd = [
  {
    '@type': 'Person',
    '@id': abs(`${path}#founder-daniela`),
    name: copy.founders[0].name,
    jobTitle: copy.founders[0].role,
    worksFor: { '@id': abs('/#organization') },
  },
];
---

<BaseLayout
  pageId="sobre-nosotros"
  jsonLdNodes={[breadcrumbJsonLd(crumbs), ...foundersJsonLd]}
  seo={{
    title: copy.metaTitle,
    description: copy.metaDescription,
    path,
    routeKey: 'sobreNosotros',
    country,
  }}
>
  <Breadcrumbs items={crumbs} ariaLabel={ui.a11y.breadcrumb} />

  <section class="container-site pt-6 pb-16 md:pt-10 md:pb-20">
    <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_1fr]">
      <div class="space-y-5">
        <p class="inline-block rounded-pill border-2 border-ink bg-lemon px-4 py-1 text-sm font-bold uppercase shadow-[3px_3px_0_0_var(--ink)]">
          {copy.eyebrow}
        </p>
        <h1 class="text-display-hero">{copy.h1}</h1>
        <p class="text-lg text-ink-soft md:text-xl">{copy.intro}</p>
        <div class="flex flex-wrap gap-3 pt-2">
          <WhatsAppButton
            message={copy.waMessage}
            label={copy.waCta}
            a11yLabel={ui.a11y.openWhatsApp}
            country={country}
            page="sobre-nosotros"
            placement="hero"
            size="lg"
          />
          <BookCallButton
            country={country}
            page="sobre-nosotros"
            placement="hero"
            variant="light"
            size="lg"
          />
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-lg lg:max-w-none">
        <Sticker color="coral" rotate={6} class="absolute -top-3 right-4 z-10 text-xs!">
          ESPAÑA ↔ MÉXICO
        </Sticker>
        <div class="overflow-hidden rounded-[32px] border-2 border-ink shadow-[10px_12px_0_0_var(--coral)]">
          <Photo
            src={equipoEscritorio}
            alt={copy.h1}
            priority
            aspect="4/3"
            widths={[360, 540, 720]}
            sizes="(min-width: 1024px) 44vw, 92vw"
          />
        </div>
      </div>
    </div>
  </section>

  <StripeBand colors={['var(--coral)', 'var(--cream)']} />

  <!-- Daniela (Fundadora) y el estudio de producción -->
  <section class="container-site py-16 md:py-24">
    <h2 class="text-display-lg">{copy.foundersTitle}</h2>
    <div class="mt-10 grid gap-8 md:grid-cols-2">
      {
        copy.founders.map((f, idx) => (
          <Card color="cream-deep" bordered class="grid gap-6 sm:grid-cols-[0.88fr_1.12fr] sm:items-center">
            <div class="overflow-hidden rounded-[24px] border-2 border-ink bg-cream shadow-[5px_5px_0_0_var(--ink)]">
              <Photo
                src={idx === 0 ? fundadoraDaniela : mesaTrabajo}
                alt={f.placeholder}
                aspect="3/4"
                widths={[320, 480]}
                sizes="(min-width: 768px) 220px, 85vw"
              />
            </div>
            <div class="space-y-3">
              <span class="inline-block rounded-pill border border-ink bg-cream px-3 py-1 text-xs font-bold uppercase">
                {f.role}
              </span>
              <h3 class="text-2xl">{f.name}</h3>
              <p class="text-sm text-ink-soft">{f.bio}</p>
            </div>
          </Card>
        ))
      }
    </div>
  </section>

  <!-- Nuestra historia + Vídeo del estudio por dentro -->
  <section class="theme-dark py-16 md:py-24">
    <div class="container-site grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="space-y-6">
        <div class="space-y-4">
          <h2 class="text-display-md text-cream">{copy.storyTitle}</h2>
          {copy.storyParagraphs.map((p) => <p class="text-lg text-cream/85">{p}</p>)}
        </div>

        <Card color="lemon" bordered class="space-y-3">
          <h2 class="text-display-md">{copy.whyTwoCountriesTitle}</h2>
          <p>{copy.whyTwoCountriesText}</p>
        </Card>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div class="overflow-hidden rounded-[28px] border-2 border-cream bg-ink shadow-[8px_8px_0_0_var(--coral)]">
          <video
            src="/videos/feediasocial-estudio-hero.mp4"
            controls
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Daniela trabajando en el estudio de Feediasocial: guiones, color y edición de Reels"
            class="aspect-[3/4] h-full w-full object-cover"
          ></video>
        </div>
        <div class="overflow-hidden rounded-[28px] border-2 border-cream shadow-[8px_8px_0_0_var(--lemon)]">
          <Photo
            src={estudioEdicion}
            alt="Daniela editando y estructurando contenido mensual en el estudio de Feediasocial"
            aspect="3/4"
            widths={[360, 540]}
            sizes="(min-width: 640px) 22vw, 90vw"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Valores honestos -->
  <section class="container-site py-16 md:py-24">
    <h2 class="text-display-lg">{copy.valuesTitle}</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        copy.values.map((v) => (
          <Card color={v.color} bordered class="space-y-3">
            <h3 class="text-3xl">{v.title}</h3>
            <p>{v.text}</p>
          </Card>
        ))
      }
    </div>

    <div class="mt-12 flex flex-wrap justify-center gap-4">
      <WhatsAppButton
        message={copy.waMessage}
        label={copy.waCta}
        a11yLabel={ui.a11y.openWhatsApp}
        country={country}
        page="sobre-nosotros"
        placement="bottom"
        size="lg"
      />
      <BookCallButton
        country={country}
        page="sobre-nosotros"
        placement="bottom"
        variant="light"
        size="lg"
      />
    </div>
  </section>
</BaseLayout>
