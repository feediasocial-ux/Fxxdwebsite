---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Card from '@/components/Card.astro';
import Button from '@/components/Button.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import CarouselPreviewMockup from '@/components/CarouselPreviewMockup.astro';
import Photo from '@/components/Photo.astro';
import { getCorePages, getUi } from '@/content';
import { getNichesByCountry } from '@/content/niches';
import { COUNTRIES, type CountryKey } from '@/lib/i18n';
import { linkTo, pathFor } from '@/lib/routes';
import { breadcrumbJsonLd, serviceJsonLd } from '@/lib/seo';

import mesaTrabajo from '@/assets/photos/feediasocial-mesa-trabajo-pantone.webp';
import estudioEdicion from '@/assets/photos/feediasocial-estudio-edicion.webp';

interface Props {
  country: CountryKey;
}
const { country } = Astro.props;
const ui = getUi(country);
const copy = getCorePages(country).servicios;
const niches = getNichesByCountry(country);
const path = pathFor('servicios', country)!;
const crumbs = [
  { name: ui.countryName, path: COUNTRIES[country].basePath },
  { name: 'Servicios', path },
];
---

<BaseLayout
  pageId="servicios"
  jsonLdNodes={[
    breadcrumbJsonLd(crumbs),
    ...serviceJsonLd({
      name: copy.h1,
      description: copy.metaDescription,
      path,
      country,
      serviceType: 'Social Media Content Production & Management',
    }),
  ]}
  seo={{
    title: copy.metaTitle,
    description: copy.metaDescription,
    path,
    routeKey: 'servicios',
    country,
  }}
>
  <Breadcrumbs items={crumbs} ariaLabel={ui.a11y.breadcrumb} />

  <section class="container-site pt-6 pb-16 md:pt-10 md:pb-20">
    <div class="grid items-center gap-10 lg:grid-cols-[1.2fr_1fr]">
      <div class="space-y-5">
        <p class="inline-block rounded-pill border-2 border-ink bg-sky px-4 py-1 text-sm font-bold uppercase shadow-[3px_3px_0_0_var(--ink)]">
          {copy.eyebrow}
        </p>
        <h1 class="text-display-hero">{copy.h1}</h1>
        <p class="text-lg text-ink-soft md:text-xl">{copy.intro}</p>
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <WhatsAppButton
            message={copy.waMessage}
            label={copy.waCta}
            a11yLabel={ui.a11y.openWhatsApp}
            country={country}
            page="servicios"
            placement="hero"
            size="lg"
          />
          <Button href={linkTo('precios', country)} variant="outline" size="lg">
            {ui.hero.ctaSecondary}
          </Button>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="overflow-hidden rounded-[28px] border-2 border-ink shadow-[8px_8px_0_0_var(--coral)]">
          <Photo src={mesaTrabajo} alt={copy.blocks[0].title} priority aspect="1/1" widths={[360, 540]} sizes="45vw" />
        </div>
        <div class="mt-6 overflow-hidden rounded-[28px] border-2 border-ink shadow-[8px_8px_0_0_var(--lemon)]">
          <Photo src={estudioEdicion} alt={copy.blocks[3].title} aspect="1/1" widths={[360, 540]} sizes="45vw" />
        </div>
      </div>
    </div>
  </section>

  <!-- Los 5 bloques de servicio -->
  <section class="container-site py-12 md:py-20">
    <h2 class="text-display-lg">{copy.blocksTitle}</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        copy.blocks.map((b, idx) => (
          <Card color={b.color} bordered class:list={['flex flex-col gap-4', idx === 4 && 'md:col-span-2']}>
            <span class="inline-block w-fit rounded-pill border border-ink bg-cream px-3 py-1 text-xs font-bold uppercase">
              {b.badge}
            </span>
            <h3 class="text-2xl md:text-3xl">{b.title}</h3>
            <p>{b.text}</p>
            <ul class="mt-auto space-y-2 pt-2 text-sm font-medium">
              {b.bullets.map((item) => (
                <li class="flex gap-2">
                  <span class="font-bold" aria-hidden="true">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </Card>
        ))
      }
    </div>
  </section>

  <!-- Plan B sin cámara + Carrusel interactivo -->
  <section class="theme-dark py-16 md:py-24">
    <div class="container-site grid items-center gap-8 md:grid-cols-[1.15fr_1fr]">
      <div class="space-y-4">
        <h2 class="text-display-md text-cream">{ui.pricing.planBTitle}</h2>
        <p class="text-lg text-cream/85">{ui.pricing.planBText}</p>
        <div class="flex flex-wrap gap-3 pt-2">
          <WhatsAppButton
            message={ui.pricing.planBWaMessage}
            label={ui.pricing.planBCta}
            a11yLabel={ui.a11y.openWhatsApp}
            country={country}
            page="servicios"
            placement="plan-b"
            variant="lemon"
            size="lg"
          />
          <Button href={linkTo('intencionSinCamara', country)} variant="outline" size="lg" class="border-cream! text-cream! hover:bg-cream! hover:text-ink!">
            {ui.pricing.planBGuideCta}
          </Button>
        </div>
      </div>
      <div class="text-ink">
        <CarouselPreviewMockup country={country} compact />
      </div>
    </div>
  </section>

  <!-- Sectores (enlaces compactos) + CTA final limpio -->
  <section class="container-site py-16 md:py-20">
    <div class="max-w-3xl space-y-2">
      <h2 class="text-display-md">{copy.nichesTitle}</h2>
      <p class="text-base text-ink-soft">{copy.nichesSubtitle}</p>
    </div>

    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        niches.map((n) => (
          <a
            href={pathFor(n.routeKey, country)!}
            class="group flex items-center justify-between gap-3 rounded-2xl border-2 border-ink bg-cream-deep px-5 py-4 text-ink no-underline shadow-[4px_4px_0_0_var(--ink)] transition-transform hover:-translate-y-0.5 hover:bg-lemon"
          >
            <span class="font-display text-lg uppercase">{n.shortTitle}</span>
            <span class="text-sm font-extrabold text-coral-deep transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>

    <div class="mt-14 flex flex-col items-start justify-between gap-6 rounded-[32px] border-2 border-ink bg-maroon p-8 text-cream shadow-[8px_8px_0_0_var(--ink)] lg:flex-row lg:items-center md:p-10">
      <div class="max-w-2xl space-y-2">
        <h2 class="text-display-md text-cream">{ui.finalCta.title}</h2>
        <p class="text-base text-cream/85 md:text-lg">{ui.finalCta.subtitle}</p>
      </div>
      <div class="flex flex-wrap gap-3 shrink-0">
        <WhatsAppButton
          message={copy.waMessage}
          label={ui.finalCta.cta}
          a11yLabel={ui.a11y.openWhatsApp}
          country={country}
          page="servicios"
          placement="final-cta"
          variant="lemon"
          size="lg"
        />
        <Button href={linkTo('precios', country)} variant="outline" size="lg" class="border-cream! text-cream! hover:bg-cream! hover:text-ink!">
          {ui.hero.ctaSecondary}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
