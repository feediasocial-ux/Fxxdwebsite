{
  "name": "feediasocial-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "node scripts/generate-og.ts && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "generate:og": "node scripts/generate-og.ts",
    "check:contrast": "node scripts/check-contrast.ts",
    "check:similarity": "node scripts/check-similarity.ts",
    "check:seo": "node scripts/check-hreflang.ts",
    "check:links": "node scripts/check-links.ts",
    "check:budget": "node scripts/check-budget.ts",
    "validate": "node scripts/check-contrast.ts && node scripts/check-similarity.ts && node scripts/check-hreflang.ts && node scripts/check-links.ts && node scripts/check-budget.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource/anton": "^5.2.8",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "vite": "8.3.5",
    "rolldown": "1.2.15"
  }
}
