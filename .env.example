# Copia a .env y rellena. En GitHub: Settings → Secrets and variables → Actions → Variables.
# Todas las variables PUBLIC_ acaban en el HTML (son públicas por naturaleza).

SITE_URL=https://feediasocial.com

# WhatsApp (solo dígitos, con prefijo internacional, sin + ni espacios)
PUBLIC_WA_NUMBER_MX=525534402921
# [PENDIENTE: número español] Mientras tanto se usa el mismo número de México.
PUBLIC_WA_NUMBER_ES=525534402921

# Formulario mini-auditoría (Formspree / Web3Forms…) [PENDIENTE]
PUBLIC_FORM_ENDPOINT=

# Medición (se cargan SOLO tras consentimiento) [PENDIENTE]
PUBLIC_GA4_ID=
PUBLIC_CLARITY_ID=
# Código de verificación de Search Console (meta tag) [PENDIENTE]
PUBLIC_GSC_VERIFICATION=
